   "source": [
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread('image.jpg', 0)\n",
    "\n",
    "edges = cv2.Canny(img, 100, 200)\n",
    "\n",
    "plt.imshow(edges, cmap='gray')\n",
    "plt.title(\"Edges\")\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
